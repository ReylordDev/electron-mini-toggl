{
  "compilerOptions": {
    "outDir": "dist",
    "module": "node16",
    "moduleResolution": "node16",
    "moduleDetection": "force",
    "target": "ES2023",
    "resolveJsonModule": false,
    "declaration": true,
    // "strict": true,
    // "noImplicitAny": true,
    "skipLibCheck": true
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "experimentalResolver": true
  }
}
